NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Required for authentication
JWT_SECRET=replace-with-a-long-random-secret

# Required for admin protection
# Example: ADMIN_USER_IDS=1,7,12
ADMIN_USER_IDS=

# Public browser origin. For Dokploy production, use your HTTPS domain.
CLIENT_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Set true only when the app is behind a trusted reverse proxy.
TRUST_PROXY=false

# MySQL settings
# Use either DATABASE_URL, DB_*, or platform MYSQL* variables.
DATABASE_URL=
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306

# Platform MySQL alternative variables
MYSQLHOST=
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=
MYSQLPORT=3306

# Optional platform MySQL aliases used by this project
RAILWAY_MYSQL_HOST=
RAILWAY_MYSQL_USER=
RAILWAY_MYSQL_PASSWORD=
RAILWAY_MYSQL_DATABASE=
RAILWAY_MYSQL_PORT=3306
